# ===========================================
# WeeklyRun API - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.sample .env

# Project
PROJECT_NAME=WeeklyRun API
PROJECT_ENV=local  # local | staging | prod

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weeklyrun

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# File Upload
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=104857600  # 100MB

# ===========================================
# Confluence API v2
# ===========================================
# Generate API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_TOKEN=your-api-token-here
CONFLUENCE_SPACE_ID=your-space-id
CONFLUENCE_REPORT_PARENT_PAGE_ID=parent-page-id-for-weekly-reports
CONFLUENCE_MINUTES_PARENT_PAGE_ID=parent-page-id-for-meeting-minutes

# ===========================================
# ElevenLabs STT
# ===========================================
# Get API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ===========================================
# OpenAI (GPT for minutes generation)
# ===========================================
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
