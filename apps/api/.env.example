# Project
PROJECT_NAME=WeeklyRun API
PROJECT_ENV=local

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weeklyrun

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# File Upload
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=104857600

# Confluence API v2
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_TOKEN=your-api-token
CONFLUENCE_SPACE_ID=123456
CONFLUENCE_REPORT_PARENT_PAGE_ID=123456789
CONFLUENCE_MINUTES_PARENT_PAGE_ID=987654321

# ElevenLabs STT
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# OpenAI (GPT for minutes generation)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
